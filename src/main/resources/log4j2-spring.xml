<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
	<Appenders>
		<Console name="Console" target="SYSTEM_OUT">
			<PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%t] %c - %msg%n%throwable"/>
		</Console>
	</Appenders>

	<Loggers>
		<Logger name="com.github.kairos.middleware.logging.HttpLoggingFilter" level="info" additivity="false">
			<AppenderRef ref="Console"/>
		</Logger>

		<Logger name="com.github.kairos.middleware.exceptionhandler.GlobalExceptionHandler" level="warn" additivity="false">
			<AppenderRef ref="Console"/>
		</Logger>

		<Root level="info">
			<AppenderRef ref="Console"/>
		</Root>
	</Loggers>
</Configuration>
